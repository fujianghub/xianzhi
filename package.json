{
  "name": "xianzhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "衔枝 / Xianzhi — 个人工作台",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n client,api,collab -c cyan,green,magenta \"vite\" \"tsx watch src/server/index.ts\" \"tsx watch src/collab/server.ts\"",
    "dev:verify": "scripts/verify-env.sh concurrently -k -n client,api,collab -c cyan,green,magenta \"vite\" \"tsx src/server/index.ts\" \"scripts/respawn.sh tsx src/collab/server.ts\"",
    "db:up": "docker compose -f infra/docker-compose.yml up -d pg mailpit",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "BETTER_AUTH_CLI=1 XZ_SKIP_DOTENV=1 pnpm dlx @better-auth/cli@1.4.21 generate --config src/server/auth.ts --output src/server/db/schema/auth.ts -y",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "biome check . && tsx scripts/check-css.ts && tsx scripts/check-contrast.ts && tsx scripts/check-i18n.ts",
    "lint:drift": "tsx scripts/check-schema-drift.ts && tsx scripts/check-openapi-drift.ts",
    "format": "biome format --write .",
    "test": "vitest run && tsx scripts/req-coverage.ts --layers unit,api,collab",
    "test:watch": "vitest",
    "e2e": "scripts/verify-env.sh tsx scripts/e2e-db.ts && playwright test --project=setup --project=desktop --project=mobile && tsx scripts/req-coverage.ts --layers e2e",
    "e2e:infra": "playwright test --project=infra && tsx scripts/req-coverage.ts --layers infra",
    "build": "vite build && tsc -p tsconfig.server.json && tsx scripts/check-budget.ts",
    "start": "node dist/server/start.js",
    "start:collab": "node dist/collab/server.js",
    "xz": "tsx src/server/cli.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.5",
    "@better-auth/passkey": "^1.7.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hocuspocus/server": "^4.7.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/jieba": "^2.0.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
