# 复制为 .env 后填写；.env 不入库。修改 .env / 密钥属红线操作（CLAUDE.md）。
DATABASE_URL=postgres://xz:xz@localhost:5433/xz
APP_URL=http://localhost:3010
API_PORT=8010
COLLAB_PORT=8011

# openssl rand -base64 48
BETTER_AUTH_SECRET=
# 必须等于浏览器访问的 APP_URL（经 Vite 代理），否则魔法链接 / 回调域错
BETTER_AUTH_URL=http://localhost:3010
# 02 §9 /collab/token 的 HMAC 密钥，≥ 32 字节随机：openssl rand -base64 48
COLLAB_TOKEN_SECRET=
# age 公钥（age1...），备份加密用（05 §8）；私钥离站，不进 .env
AGE_RECIPIENT=

# dev 用 Mailpit：SMTP 1025，Web UI http://localhost:8025
# 用 127.0.0.1 而非 localhost：localhost 先解析到 ::1，连 Docker 发布端口会先超时再回落 IPv4
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Xianzhi <no-reply@xz.local>

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 可空，AI 功能优雅降级（二期）
ANTHROPIC_API_KEY=
AI_MODEL=

DATA_DIR=./data
LOG_LEVEL=info
